#. Plugin Name of the plugin
#: denar-for-woocommerce.php
msgid "Denár for WooCommerce"
msgstr "Denár pre WooCommerce"

#. Plugin URI of the plugin
#: denar-for-woocommerce.php
msgid "https://denar.sk/"
msgstr ""

#. Description of the plugin
#: denar-for-woocommerce.php
msgid "Issues invoices for WooCommerce orders in Denár - proforma with PAY by square for bank transfers, invoice once paid, credit note on refund."
msgstr "Vystavuje doklady k objednávkam WooCommerce v Denári - pri prevode zálohovú faktúru s PAY by square, po úhrade faktúru, pri vrátení peňazí dobropis."

